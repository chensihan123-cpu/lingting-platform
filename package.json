  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "leaflet": "1.9.4",
    "wavefile": "11.0.0"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "vite": "7.3.6"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
